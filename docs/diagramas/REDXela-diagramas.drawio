<diagram name="9. Comparador de políticas" id="redxela-09"><mxGraphModel dx="880" dy="640" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="880" pageHeight="640" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="k1" value="1 · La misma carga para todas las políticas" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#dae8fc;fillOpacity=35;strokeColor=#6c8ebf;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=14;spacingRight=14;spacingTop=6;fontSize=16;fontStyle=1;fontColor=#2b3440;" vertex="1" parent="1"><mxGeometry x="15" y="10" width="850" height="150" as="geometry" /></mxCell><mxCell id="i2" value="" style="shape=mxgraph.lean_mapping.schedule;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="83.0" y="50" width="44.0" height="44" as="geometry" /></mxCell><mxCell id="t3" value="&lt;b&gt;Parámetros&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px;color:#5b6676'&gt;pedidos · intensidad · semilla&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=14;fontColor=#2b3440;fontStyle=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="20.0" y="96" width="170" height="56" as="geometry" /></mxCell><mxCell id="i4" value="" style="shape=mxgraph.lean_mapping.orders;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="358.0" y="50" width="44.0" height="44" as="geometry" /></mxCell><mxCell id="t5" value="&lt;b&gt;WorkloadTrace&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px;color:#5b6676'&gt;qué llega y cuándo, precalculado&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=14;fontColor=#2b3440;fontStyle=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="275.0" y="96" width="210" height="44" as="geometry" /></mxCell><mxCell id="b6" value="La traza sale &lt;b&gt;solo de la semilla&lt;/b&gt;: pedidos e instantes de llegada quedan fijos, así que las 5 políticas reciben una entrada idéntica y no dependen de cuándo se despierte un hilo." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=12;fontColor=#2b3440;align=left;verticalAlign=middle;fontStyle=0;dashed=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="560" y="48" width="285" height="92" as="geometry" /></mxCell><mxCell id="e7" value="genera" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#4a5568;endArrow=block;endFill=1;fontSize=12;fontColor=#2b3440;labelBackgroundColor=#ffffff;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="i2" target="i4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="k8" value="2 · Una corrida aislada por política, en secuencia, todas con la misma traza" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#e1d5e7;fillOpacity=35;strokeColor=#9673a6;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=14;spacingRight=14;spacingTop=6;fontSize=16;fontStyle=1;fontColor=#2b3440;" vertex="1" parent="1"><mxGeometry x="15" y="175" width="850" height="270" as="geometry" /></mxCell><mxCell id="b9" value="&lt;b&gt;FIFO&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=13;fontColor=#2b3440;align=center;verticalAlign=middle;fontStyle=0;dashed=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="30" y="225" width="130" height="62" as="geometry" /></mxCell><mxCell id="b10" value="&lt;b&gt;Prioridad&lt;br&gt;estricta&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=13;fontColor=#2b3440;align=center;verticalAlign=middle;fontStyle=0;dashed=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="190" y="225" width="130" height="62" as="geometry" /></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#4a5568;endArrow=block;endFill=1;fontSize=12;fontColor=#2b3440;labelBackgroundColor=#ffffff;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b9" target="b10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="b12" value="&lt;b&gt;Prioridad con&lt;br&gt;envejecimiento&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=13;fontColor=#2b3440;align=center;verticalAlign=middle;fontStyle=0;dashed=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="350" y="225" width="130" height="62" as="geometry" /></mxCell><mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#4a5568;endArrow=block;endFill=1;fontSize=12;fontColor=#2b3440;labelBackgroundColor=#ffffff;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b10" target="b12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="b14" value="&lt;b&gt;EDF&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=13;fontColor=#2b3440;align=center;verticalAlign=middle;fontStyle=0;dashed=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="510" y="225" width="130" height="62" as="geometry" /></mxCell><mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#4a5568;endArrow=block;endFill=1;fontSize=12;fontColor=#2b3440;labelBackgroundColor=#ffffff;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b12" target="b14"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="b16" value="&lt;b&gt;SJF&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=13;fontColor=#2b3440;align=center;verticalAlign=middle;fontStyle=0;dashed=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="670" y="225" width="130" height="62" as="geometry" /></mxCell><mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#4a5568;endArrow=block;endFill=1;fontSize=12;fontColor=#2b3440;labelBackgroundColor=#ffffff;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b14" target="b16"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="b18" value="&lt;b&gt;PolicyRun&lt;/b&gt;: reloj propio a ×600 (1 s real = 10 min simulados), pools, inventario, planificador y procesador &lt;b&gt;propios&lt;/b&gt;, que se desarman al terminar → no toca el sistema en vivo.&lt;br&gt;&lt;b&gt;Stock abundante y sin camiones&lt;/b&gt;: lo que no depende de la política queda fuera, para que la única diferencia sea el criterio de orden.&lt;br&gt;&lt;b&gt;En secuencia, no en paralelo&lt;/b&gt;: si compitieran por el procesador, el ruido de los hilos distorsionaría lo medido." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=12;fontColor=#2b3440;align=left;verticalAlign=middle;fontStyle=0;dashed=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="310" width="800" height="120" as="geometry" /></mxCell><mxCell id="k19" value="3 · Resultados lado a lado (se publican a medida que terminan)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#d5e8d4;fillOpacity=35;strokeColor=#82b366;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=14;spacingRight=14;spacingTop=6;fontSize=16;fontStyle=1;fontColor=#2b3440;" vertex="1" parent="1"><mxGeometry x="15" y="460" width="850" height="170" as="geometry" /></mxCell><mxCell id="i20" value="" style="shape=mxgraph.sitemap.chart;html=1;fillColor=#d0ece9;strokeColor=#2a9d8f;strokeWidth=2;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="68.0" y="500" width="44.0" height="44" as="geometry" /></mxCell><mxCell id="t21" value="&lt;b&gt;Métricas&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px;color:#5b6676'&gt;por política&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=14;fontColor=#2b3440;fontStyle=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="30.0" y="546" width="120" height="36" as="geometry" /></mxCell><mxCell id="b22" value="&lt;b&gt;Espera promedio y máxima por nivel&lt;/b&gt; (la máxima revela inanición) · &lt;b&gt;% atendidos a tiempo&lt;/b&gt; · &lt;b&gt;rendimiento&lt;/b&gt; · &lt;b&gt;ocupación de encargados&lt;/b&gt;.&lt;br&gt;&lt;br&gt;La interfaz resalta el mejor valor de cada fila (las diferencias de ruido cuentan como empate), resume quién ganó en qué y permite &lt;b&gt;«Usar esta política»&lt;/b&gt; para cambiar la del sistema en vivo." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=12;fontColor=#2b3440;align=left;verticalAlign=middle;fontStyle=0;dashed=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="180" y="495" width="665" height="125" as="geometry" /></mxCell></root></mxGraphModel></diagram>
