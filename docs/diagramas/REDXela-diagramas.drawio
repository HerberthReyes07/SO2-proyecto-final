" height="44" as="geometry" /></mxCell><mxCell id="t12" value="&lt;b&gt;ReentrantLock&lt;/b&gt; protege todo el estado: dueños, esperas y contadores de ocupación" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#2b3440;fontStyle=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="370" y="62" width="470" height="50" as="geometry" /></mxCell><mxCell id="t13" value="&lt;b&gt;Dueños&lt;/b&gt; (unidades en uso)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;fontColor=#2b3440;fontStyle=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="300" y="125" width="280" height="24" as="geometry" /></mxCell><mxCell id="b14" value="TRK-1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=14;fontColor=#2b3440;align=center;verticalAlign=middle;fontStyle=1;dashed=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="300" y="152" width="120" height="40" as="geometry" /></mxCell><mxCell id="b15" value="TRK-2" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=14;fontColor=#2b3440;align=center;verticalAlign=middle;fontStyle=1;dashed=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="430" y="152" width="120" height="40" as="geometry" /></mxCell><mxCell id="t16" value="capacidad 2 → ninguna libre" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#5b6676;fontStyle=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="560" y="152" width="280" height="40" as="geometry" /></mxCell><mxCell id="t17" value="&lt;b&gt;Esperas&lt;/b&gt; ordenadas por la política (menor clave primero)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;fontColor=#2b3440;fontStyle=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="300" y="215" width="400" height="24" as="geometry" /></mxCell><mxCell id="b18" value="TRK-4 (camión)&lt;br&gt;&lt;font style='font-size:11px'&gt;Condition propia&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=13;fontColor=#2b3440;align=center;verticalAlign=middle;fontStyle=1;dashed=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="300" y="248" width="250" height="46" as="geometry" /></mxCell><mxCell id="b19" value="ORD-21 (Exprés)&lt;br&gt;&lt;font style='font-size:11px'&gt;Condition propia&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=13;fontColor=#2b3440;align=center;verticalAlign=middle;fontStyle=1;dashed=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="300" y="304" width="250" height="46" as="geometry" /></mxCell><mxCell id="b20" value="ORD-18 (Económico)&lt;br&gt;&lt;font style='font-size:11px'&gt;Condition propia&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=13;fontColor=#2b3440;align=center;verticalAlign=middle;fontStyle=1;dashed=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="300" y="360" width="250" height="46" as="geometry" /></mxCell><mxCell id="t21" value="Cada espera duerme en &lt;b&gt;su propia&lt;/b&gt; Condition: al liberar una unidad se despierta &lt;b&gt;solo al siguiente&lt;/b&gt; (no hay &lt;i&gt;thundering herd&lt;/i&gt;).&lt;br&gt;&lt;br&gt;Los camiones van antes que los pedidos (la recepción desbloquea el flujo de stock); los empates se resuelven por orden de llegada al pool." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#2b3440;fontStyle=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="560" y="248" width="280" height="160" as="geometry" /></mxCell><mxCell id="b22" value="&lt;b&gt;release(op)&lt;/b&gt;: devuelve la unidad → &lt;b&gt;signalNextWaiter()&lt;/b&gt; despierta al mejor candidato" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;fontColor=#2b3440;align=left;verticalAlign=middle;fontStyle=0;dashed=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="300" y="430" width="540" height="38" as="geometry" /></mxCell><mxCell id="b23" value="&lt;b&gt;preempt(op)&lt;/b&gt;: expulsa a quien espera (víctima de un deadlock) → OperationPreemptedException" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=13;fontColor=#2b3440;align=left;verticalAlign=middle;fontStyle=0;dashed=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="300" y="478" width="540" height="38" as="geometry" /></mxCell><mxCell id="b24" value="&lt;b&gt;awaitAvailableUnit()&lt;/b&gt;: espera capacidad &lt;i&gt;sin tomarla&lt;/i&gt; (solo el despachador la usa)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=13;fontColor=#2b3440;align=left;verticalAlign=middle;fontStyle=0;dashed=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="300" y="526" width="540" height="38" as="geometry" /></mxCell><mxCell id="t25" value="Mide la ocupación integrando «unidades ocupadas × tiempo» en cada cambio (exacto, con el reloj simulado)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#5b6676;fontStyle=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="300" y="572" width="540" height="30" as="geometry" /></mxCell><mxCell id="f26" value="acquire()" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#4a5568;fontSize=12;fontColor=#2b3440;labelBackgroundColor=#ffffff;dashed=0;rounded=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="168" y="100" as="sourcePoint" /><mxPoint x="300" y="270" as="targetPoint" /></mxGeometry></mxCell><mxCell id="f27" value="acquire()" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#4a5568;fontSize=12;fontColor=#2b3440;labelBackgroundColor=#ffffff;dashed=0;rounded=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="168" y="250" as="sourcePoint" /><mxPoint x="300" y="330" as="targetPoint" /></mxGeometry></mxCell><mxCell id="f28" value="acquire()" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#4a5568;fontSize=12;fontColor=#2b3440;labelBackgroundColor=#ffffff;dashed=0;rounded=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="168" y="400" as="sourcePoint" /><mxPoint x="300" y="385" as="targetPoint" /></mxGeometry></mxCell><mxCell id="f29" value="" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#6c8ebf;fontSize=12;fontColor=#2b3440;labelBackgroundColor=#ffffff;dashed=1;rounded=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="168" y="535" as="sourcePoint" /><mxPoint x="300" y="545" as="targetPoint" /></mxGeometry></mxCell></root></mxGraphModel></diagram>
<diagram name="5. Recepción e Inventario" id="redxela-05"><mxGraphModel dx="880" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="880" pageHeight="700" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="k1" value="Recepción · un hilo por camión (productores)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#dae8fc;fillOpacity=35;strokeColor=#6c8ebf;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=14;spacingRight=14;spacingTop=6;fontSize=16;fontStyle=1;fontColor=#2b3440;" vertex="1" parent="1"><mxGeometry x="20" y="15" width="840" height="200" as="geometry" /></mxCell><mxCell id="i2" value="" style="shape=mxgraph.lean_mapping.truck_shipment;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="76.0" y="55" width="48.0" height="48" as="geometry" /></mxCell><mxCell id="t3" value="&lt;b&gt;Camión&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px;color:#5b6676'&gt;hasta 100 pendientes&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=14;fontColor=#2b3440;fontStyle=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="25.0" y="105" width="150" height="44" as="geometry" /></mxCell><mxCell id="b4" value="&lt;b&gt;1&lt;/b&gt; toma Escáner&lt;br&gt;y Área de carga" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=12;fontColor=#2b3440;align=center;verticalAlign=middle;fontStyle=0;dashed=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="190" y="55" width="150" height="70" as="geometry" /></mxCell><mxCell id="b5" value="&lt;b&gt;2&lt;/b&gt; descarga&lt;br&gt;1 s simulado/unidad" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=12;fontColor=#2b3440;align=center;verticalAlign=middle;fontStyle=0;dashed=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="360" y="55" width="130" height="70" as="geometry" /></mxCell><mxCell id="b6" value="&lt;b&gt;3&lt;/b&gt; SUELTA los&lt;br&gt;recursos" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=12;fontColor=#2b3440;align=center;verticalAlign=middle;fontStyle=1;dashed=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="510" y="55" width="150" height="70" as="geometry" /></mxCell><mxCell id="b7" value="&lt;b&gt;4&lt;/b&gt; reporta a Inventario&lt;br&gt;ReceptionMessage" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=12;fontColor=#2b3440;align=center;verticalAlign=middle;fontStyle=0;dashed=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="680" y="55" width="150" height="70" as="geometry" /></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#4a5568;endArrow=block;endFill=1;fontSize=12;fontColor=#2b3440;labelBackgroundColor=#ffffff;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="i2" target="b4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#4a5568;endArrow=block;endFill=1;fontSize=12;fontColor=#2b3440;labelBackgroundColor=#ffffff;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b4" target="b5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#4a5568;endArrow=block;endFill=1;fontSize=12;fontColor=#2b3440;labelBackgroundColor=#ffffff;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b5" target="b6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#4a5568;endArrow=block;endFill=1;fontSize=12;fontColor=#2b3440;labelBackgroundColor=#ffffff;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b6" target="b7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="t12" value="&lt;b&gt;Por qué suelta antes de reportar:&lt;/b&gt; si retuviera el escáner mientras espera lugar en el buffer, un Inventario lento dejaría el único escáner ocupado por camiones que ya terminaron y paralizaría los despachos." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#2b3440;fontStyle=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="190" y="140" width="500" height="66" as="geometry" /></mxCell><mxCell id="k13" value="ReceptionBuffer · productor/consumidor acotado (Lock + 2 Condition)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffe6cc;fillOpacity=35;strokeColor=#d79b00;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=14;spacingRight=14;spacingTop=6;fontSize=16;fontStyle=1;fontColor=#2b3440;" vertex="1" parent="1"><mxGeometry x="20" y="260" width="840" height="190" as="geometry" /></mxCell><mxCell id="f14" value="put()" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#4a5568;fontSize=12;fontColor=#2b3440;labelBackgroundColor=#ffffff;dashed=0;rounded=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="755" y="125" as="sourcePoint" /><mxPoint x="755" y="255" as="targetPoint" /></mxGeometry></mxCell><mxCell id="b15" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=10;fontColor=#2b3440;align=center;verticalAlign=middle;fontStyle=0;dashed=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="310" width="38" height="38" as="geometry" /></mxCell><mxCell id="b16" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=10;fontColor=#2b3440;align=center;verticalAlign=middle;fontStyle=0;dashed=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="104" y="310" width="38" height="38" as="geometry" /></mxCell><mxCell id="b17" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=10;fontColor=#2b3440;align=center;verticalAlign=middle;fontStyle=0;dashed=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="148" y="310" width="38" height="38" as="geometry" /></mxCell><mxCell id="b18" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=10;fontColor=#2b3440;align=center;verticalAlign=middle;fontStyle=0;dashed=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="192" y="310" width="38" height="38" as="geometry" /></mxCell><mxCell id="b19" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=2;fontSize=10;fontColor=#2b3440;align=center;verticalAlign=middle;fontStyle=0;dashed=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="236" y="310" width="38" height="38" as="geometry" /></mxCell><mxCell id="b20" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=2;fontSize=10;fontColor=#2b3440;align=center;verticalAlign=middle;fontStyle=0;dashed=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="280" y="310" width="38" height="38" as="geometry" /></mxCell><mxCell id="b21" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=2;fontSize=10;fontColor=#2b3440;align=center;verticalAlign=middle;fontStyle=0;dashed=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="324" y="310" width="38" height="38" as="geometry" /></mxCell><mxCell id="b22" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=2;fontSize=10;fontColor=#2b3440;align=center;verticalAlign=middle;fontStyle=0;dashed=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="368" y="310" width="38" height="38" as="geometry" /></mxCell><mxCell id="b23" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=2;fontSize=10;fontColor=#2b3440;align=center;verticalAlign=middle;fontStyle=0;dashed=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="412" y="310" width="38" height="38" as="geometry" /></mxCell><mxCell id="b24" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=2;fontSize=10;fontColor=#2b3440;align=center;verticalAlign=middle;fontStyle=0;dashed=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="456" y="310" width="38" height="38" as="geometry" /></mxCell><mxCell id="t25" value="capacidad 10 mensajes (4 ocupados en el ejemplo)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#5b6676;fontStyle=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="60" y="352" width="440" height="22" as="geometry" /></mxCell><mxCell id="b26" value="&lt;b&gt;notFull&lt;/b&gt;: esperan los productores&lt;br&gt;(lleno → el camión espera)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=12;fontColor=#2b3440;align=center;verticalAlign=middle;fontStyle=0;dashed=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="385" width="210" height="52" as="geometry" /></mxCell><mxCell id="b27" value="&lt;b&gt;notEmpty&lt;/b&gt;: espera el consumidor&lt;br&gt;(vacío → Inventario duerme)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;fontColor=#2b3440;align=center;verticalAlign=middle;fontStyle=0;dashed=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="290" y="385" width="210" height="52" as="geometry" /></mxCell><mxCell id="b28" value="&lt;b&gt;Sin pérdida de datos:&lt;/b&gt; un mensaje nunca se descarta; si no hay lugar, el productor espera (interrumpible).&lt;br&gt;&lt;br&gt;&lt;b&gt;Contrapresión visible:&lt;/b&gt; el buffer cuenta los productores bloqueados y la interfaz lo muestra." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=12;fontColor=#2b3440;align=left;verticalAlign=middle;fontStyle=0;dashed=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="540" y="300" width="290" height="138" as="geometry" /></mxCell><mxCell id="k29" value="Inventario · un hilo consumidor, a su propio ritmo" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#d5e8d4;fillOpacity=35;strokeColor=#82b366;strokeWidth=2;dashed=1;verticalAlign=top;align=right;spacingLeft=14;spacingRight=14;spacingTop=6;fontSize=16;fontStyle=1;fontColor=#2b3440;" vertex="1" parent="1"><mxGeometry x="20" y="495" width="840" height="190" as="geometry" /></mxCell><mxCell id="i30" value="" style="shape=mxgraph.lean_mapping.inventory_box;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="77.0" y="535" width="46.0" height="46" as="geometry" /></mxCell><mxCell id="t31" value="&lt;b&gt;InventoryWorker&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px;color:#5b6676'&gt;20 s + 1 s por unidad&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=14;fontColor=#2b3440;fontStyle=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="15.0" y="583" width="170" height="44" as="geometry" /></mxCell><mxCell id="i32" value="" style="shape=mxgraph.lean_mapping.warehouse;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="307.0" y="535" width="46.0" height="46" as="geometry" /></mxCell><mxCell id="t33" value="&lt;b&gt;Warehouse&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px;color:#5b6676'&gt;asigna ubicaciones&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=14;fontColor=#2b3440;fontStyle=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="255.0" y="583" width="150" height="44" as="geometry" /></mxCell><mxCell id="i34" value="" style="shape=mxgraph.lean_mapping.mrp_erp;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="497.0" y="535" width="46.0" height="46" as="geometry" /></mxCell><mxCell id="t35" value="&lt;b&gt;Inventory&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px;color:#5b6676'&gt;suma al stock&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=14;fontColor=#2b3440;fontStyle=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="455.0" y="583" width="130" height="44" as="geometry" /></mxCell><mxCell id="e36" value="1 almacena" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#4a5568;endArrow=block;endFill=1;fontSize=12;fontColor=#2b3440;labelBackgroundColor=#ffffff;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="i30" target="i32"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e37" value="2 suma lo almacenado" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#4a5568;endArrow=block;endFill=1;fontSize=12;fontColor=#2b3440;labelBackgroundColor=#ffffff;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="i32" target="i34"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="b38" value="&lt;b&gt;stockChanged()&lt;/b&gt;&lt;br&gt;avisa al planificador → reevalúa pedidos que esperaban stock" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d0ece9;strokeColor=#2a9d8f;strokeWidth=2;fontSize=12;fontColor=#2b3440;align=center;verticalAlign=middle;fontStyle=0;dashed=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="660" y="540" width="175" height="76" as="geometry" /></mxCell><mxCell id="e39" value="3 avisa" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#4a5568;endArrow=block;endFill=1;fontSize=12;fontColor=#2b3440;labelBackgroundColor=#ffffff;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="i34" target="b38"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="t40" value="El planificador &lt;b&gt;nunca toca&lt;/b&gt; las estructuras de Inventario, ni Recepción las de Inventario: solo se comunican por mensajes y avisos." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#2b3440;fontStyle=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="40" y="632" width="790" height="44" as="geometry" /></mxCell><mxCell id="f41" value="take()" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#4a5568;fontSize=12;fontColor=#2b3440;labelBackgroundColor=#ffffff;dashed=0;rounded=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="100" y="450" as="sourcePoint" /><mxPoint x="100" y="535" as="targetPoint" /></mxGeometry></mxCell></root></mxGraphModel></diagram>
<diagram name="6. Deadlock: grafo y Coffman" id="redxela-06"><mxGraphModel dx="880" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="880" pageHeight="600" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="k1" value="Grafo de asignación de recursos en el momento del deadlock" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f8cecc;fillOpacity=35;strokeColor=#b85450;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=14;spacingRight=14;spacingTop=6;fontSize=16;fontStyle=1;fontColor=#2b3440;" vertex="1" parent="1"><mxGeometry x="20" y="15" width="560" height="505" as="geometry" /></mxCell><mxCell id="o2" value="Pedido&lt;br&gt;ORD-1&lt;br&gt;&lt;font style='font-size:11px'&gt;en despacho&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#2b3440;" vertex="1" parent="1"><mxGeometry x="70" y="100" width="100" height="100" as="geometry" /></mxCell><mxCell id="i3" value="" style="shape=mxgraph.networks2.scanner;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="94.0" y="345" width="52.0" height="52" as="geometry" /></mxCell><mxCell id="t4" value="&lt;b&gt;Escáner&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px;color:#5b6676'&gt;1 unidad&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=14;fontColor=#2b3440;fontStyle=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="55.0" y="399" width="130" height="44" as="geometry" /></mxCell><mxCell id="i5" value="" style="shape=mxgraph.lean_mapping.crossDock;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="414.0" y="124" width="52.0" height="52" as="geometry" /></mxCell><mxCell id="t6" value="&lt;b&gt;Área de carga&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px;color:#5b6676'&gt;2 unidades&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=bottom;fontSize=14;fontColor=#2b3440;fontStyle=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="365.0" y="76" width="150" height="46" as="geometry" /></mxCell><mxCell id="o7" value="Camiones&lt;br&gt;TRK-1 y TRK-2&lt;br&gt;&lt;font style='font-size:11px'&gt;una unidad cada uno&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#2b3440;" vertex="1" parent="1"><mxGeometry x="380" y="320" width="120" height="120" as="geometry" /></mxCell><mxCell id="e8" value="retiene" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;strokeColor=#2f6f2f;endArrow=block;endFill=1;fontSize=12;fontColor=#2b3440;labelBackgroundColor=#ffffff;dashed=0;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="i3" target="o2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e9" value="espera" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;strokeColor=#b85450;endArrow=block;endFill=1;fontSize=12;fontColor=#2b3440;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="o2" target="i5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e10" value="retiene" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;strokeColor=#2f6f2f;endArrow=block;endFill=1;fontSize=12;fontColor=#2b3440;labelBackgroundColor=#ffffff;dashed=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="i5" target="o7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e11" value="espera" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;strokeColor=#b85450;endArrow=block;endFill=1;fontSize=12;fontColor=#2b3440;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="o7" target="i3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="t12" value="&lt;font color='#2f6f2f'&gt;&lt;b&gt;— retiene&lt;/b&gt;&lt;/font&gt; (asignación)    &lt;font color='#b85450'&gt;&lt;b&gt;- - espera&lt;/b&gt;&lt;/font&gt; (solicitud)&lt;br&gt;Ciclo: Pedido → Área de carga → Camión → Escáner → Pedido" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#2b3440;fontStyle=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="520" height="40" as="geometry" /></mxCell><mxCell id="k13" value="Condiciones de Coffman" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fff2cc;fillOpacity=35;strokeColor=#d6b656;strokeWidth=2;dashed=0;verticalAlign=top;align=left;spacingLeft=14;spacingRight=14;spacingTop=6;fontSize=16;fontStyle=1;fontColor=#2b3440;" vertex="1" parent="1"><mxGeometry x="600" y="15" width="260" height="505" as="geometry" /></mxCell><mxCell id="b14" value="&lt;b&gt;1 · Exclusión mutua&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;cada unidad de escáner o de área de carga la usa una sola operación&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=13;fontColor=#2b3440;align=center;verticalAlign=middle;fontStyle=0;dashed=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="615" y="65" width="230" height="105" as="geometry" /></mxCell><mxCell id="b15" value="&lt;b&gt;2 · Retención y espera&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;cada operación retiene un recurso mientras espera otro&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=13;fontColor=#2b3440;align=center;verticalAlign=middle;fontStyle=0;dashed=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="615" y="177" width="230" height="105" as="geometry" /></mxCell><mxCell id="b16" value="&lt;b&gt;3 · Sin apropiación&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;nadie puede quitarle un recurso a otra (salvo la expulsión que decide el usuario)&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=13;fontColor=#2b3440;align=center;verticalAlign=middle;fontStyle=0;dashed=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="615" y="289" width="230" height="105" as="geometry" /></mxCell><mxCell id="b17" value="&lt;b&gt;4 · Espera circular&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;Pedido → Área de carga → Camión → Escáner → Pedido&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=13;fontColor=#2b3440;align=center;verticalAlign=middle;fontStyle=0;dashed=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="615" y="401" width="230" height="105" as="geometry" /></mxCell></root></mxGraphModel></diagram>
<diagram name="7. Deadlock: detección y recuperación" id="redxela-07"><mxGraphModel dx="880" dy="640" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="880" pageHeight="640" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="k1" value="1 · Detección (hilo propio, sin bloquear a nadie)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#dae8fc;fillOpacity=35;strokeColor=#6c8ebf;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=14;spacingRight=14;spacingTop=6;fontSize=16;fontStyle=1;fontColor=#2b3440;" vertex="1" parent="1"><mxGeometry x="15" y="10" width="850" height="205" as="geometry" /></mxCell><mxCell id="b2" value="&lt;b&gt;Detector&lt;/b&gt;&lt;br&gt;revisa cada 500 ms" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;fontColor=#2b3440;align=center;verticalAlign=middle;fontStyle=0;dashed=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="30" y="75" width="100" height="80" as="geometry" /></mxCell><mxCell id="b3" value="Lee los 6 pools&lt;br&gt;&lt;font style='font-size:11px'&gt;Asignación · Solicitud · Disponible&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;fontColor=#2b3440;align=center;verticalAlign=middle;fontStyle=0;dashed=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="150" y="75" width="130" height="80" as="geometry" /></mxCell><mxCell id="b4" value="&lt;b&gt;DeadlockAnalyzer&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;función pura · recursos de varias instancias&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=12;fontColor=#2b3440;align=center;verticalAlign=middle;fontStyle=0;dashed=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="300" y="75" width="140" height="80" as="geometry" /></mxCell><mxCell id="r5" value="¿Alguna operación no puede terminar?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=11;fontColor=#2b3440;align=center;verticalAlign=middle;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="460" y="65" width="140" height="100" as="geometry" /></mxCell><mxCell id="r6" value="¿Mismo conjunto 2 veces seguidas?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=11;fontColor=#2b3440;align=center;verticalAlign=middle;spacingLeft=0;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="620" y="65" width="120" height="100" as="geometry" /></mxCell><mxCell id="b7" value="&lt;b&gt;Deadlock confirmado&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=12;fontColor=#2b3440;align=center;verticalAlign=middle;fontStyle=0;dashed=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="760" y="75" width="90" height="80" as="geometry" /></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#4a5568;endArrow=block;endFill=1;fontSize=12;fontColor=#2b3440;labelBackgroundColor=#ffffff;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#4a5568;endArrow=block;endFill=1;fontSize=12;fontColor=#2b3440;labelBackgroundColor=#ffffff;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b3" target="b4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#4a5568;endArrow=block;endFill=1;fontSize=12;fontColor=#2b3440;labelBackgroundColor=#ffffff;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b4" target="r5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e11" value="sí" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#4a5568;endArrow=block;endFill=1;fontSize=12;fontColor=#2b3440;labelBackgroundColor=#ffffff;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="r5" target="r6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e12" value="sí" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#b85450;endArrow=block;endFill=1;fontSize=12;fontColor=#2b3440;labelBackgroundColor=#ffffff;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="r6" target="b7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="t13" value="&lt;b&gt;no&lt;/b&gt;: todo normal; sigue vigilando" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#5b6676;fontStyle=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="450" y="170" width="150" height="40" as="geometry" /></mxCell><mxCell id="t14" value="&lt;b&gt;no&lt;/b&gt;: espera la siguiente revisión" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#5b6676;fontStyle=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="610" y="170" width="135" height="40" as="geometry" /></mxCell><mxCell id="t15" value="Cada pool tiene su propio lock: leerlos no da una foto atómica. Como un deadlock real es estable, se confirma solo si el conjunto se repite → no hay falsos positivos." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#5b6676;fontStyle=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="30" y="168" width="400" height="42" as="geometry" /></mxCell><mxCell id="k16" value="2 · Recuperación manual por apropiación (la elige el usuario)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#d5e8d4;fillOpacity=35;strokeColor=#82b366;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=14;spacingRight=14;spacingTop=6;fontSize=16;fontStyle=1;fontColor=#2b3440;" vertex="1" parent="1"><mxGeometry x="15" y="230" width="850" height="215" as="geometry" /></mxCell><mxCell id="b17" value="La interfaz muestra la alerta&lt;br&gt;&lt;font style='font-size:11px'&gt;recursos disputados, operaciones bloqueadas y por qué&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;fontColor=#2b3440;align=center;verticalAlign=middle;fontStyle=0;dashed=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="30" y="275" width="170" height="80" as="geometry" /></mxCell><mxCell id="b18" value="El usuario elige cuál operación &lt;b&gt;continúa&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;fontColor=#2b3440;align=center;verticalAlign=middle;fontStyle=0;dashed=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="225" y="275" width="140" height="80" as="geometry" /></mxCell><mxCell id="b19" value="&lt;b&gt;preempt(víctima)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;expulsa a quien espera: lanza OperationPreemptedException&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=12;fontColor=#2b3440;align=center;verticalAlign=middle;fontStyle=0;dashed=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="390" y="275" width="165" height="80" as="geometry" /></mxCell><mxCell id="b20" value="&lt;b&gt;Pedido&lt;/b&gt;: libera todo y devuelve su stock; vuelve a la lista con el &lt;i&gt;mismo&lt;/i&gt; QueuedOrder (+1 reintento)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=11;fontColor=#2b3440;align=left;verticalAlign=middle;fontStyle=0;dashed=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="585" y="262" width="265" height="56" as="geometry" /></mxCell><mxCell id="b21" value="&lt;b&gt;Camión&lt;/b&gt;: libera todo y espera 2 min simulados antes de reintentar (si no, recuperaría el recurso y repetiría el deadlock)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=11;fontColor=#2b3440;align=left;verticalAlign=middle;fontStyle=0;dashed=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="585" y="326" width="265" height="56" as="geometry" /></mxCell><mxCell id="e22" value="se muestra en la interfaz" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#b85450;endArrow=block;endFill=1;fontSize=12;fontColor=#2b3440;labelBackgroundColor=#ffffff;dashed=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b7" target="b17"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="805" y="222" /><mxPoint x="22" y="222" /><mxPoint x="22" y="315" /></Array></mxGeometry></mxCell><mxCell id="e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#4a5568;endArrow=block;endFill=1;fontSize=12;fontColor=#2b3440;labelBackgroundColor=#ffffff;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b17" target="b18"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#4a5568;endArrow=block;endFill=1;fontSize=12;fontColor=#2b3440;labelBackgroundColor=#ffffff;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b18" target="b19"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#4a5568;endArrow=block;endFill=1;fontSize=12;fontColor=#2b3440;labelBackgroundColor=#ffffff;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b19" target="b20"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#4a5568;endArrow=block;endFill=1;fontSize=12;fontColor=#2b3440;labelBackgroundColor=#ffffff;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b19" target="b21"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="t27" value="Después el detector &lt;b&gt;vuelve a evaluar&lt;/b&gt;: si queda otro ciclo se presenta el siguiente. Si el deadlock se deshizo solo, o se elige una operación ajena al conflicto, la API responde 409 o 400 y no cambia nada." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#2b3440;fontStyle=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="30" y="395" width="820" height="40" as="geometry" /></mxCell><mxCell id="k28" value="3 · Prevención: romper la espera circular con un orden global de recursos (activa por defecto)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffe6cc;fillOpacity=35;strokeColor=#d79b00;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=14;spacingRight=14;spacingTop=6;fontSize=16;fontStyle=1;fontColor=#2b3440;" vertex="1" parent="1"><mxGeometry x="15" y="460" width="850" height="170" as="geometry" /></mxCell><mxCell id="i29" value="" style="shape=mxgraph.networks2.scanner;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="63.0" y="502" width="44.0" height="44" as="geometry" /></mxCell><mxCell id="t30" value="&lt;b&gt;Escáner&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px;color:#5b6676'&gt;rank 5&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=14;fontColor=#2b3440;fontStyle=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="30.0" y="548" width="110" height="36" as="geometry" /></mxCell><mxCell id="i31" value="" style="shape=mxgraph.lean_mapping.crossDock;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="213.0" y="502" width="44.0" height="44" as="geometry" /></mxCell><mxCell id="t32" value="&lt;b&gt;Área de carga&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px;color:#5b6676'&gt;rank 6&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=14;fontColor=#2b3440;fontStyle=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="170.0" y="548" width="130" height="36" as="geometry" /></mxCell><mxCell id="e33" value="antes que" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#4a5568;endArrow=block;endFill=1;fontSize=12;fontColor=#2b3440;labelBackgroundColor=#ffffff;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="i29" target="i31"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="b34" value="Todas las operaciones (pedidos &lt;i&gt;y&lt;/i&gt; camiones) piden en el mismo orden. Un ciclo exigiría que alguien espere un recurso de &lt;b&gt;menor&lt;/b&gt; rank mientras retiene uno de &lt;b&gt;mayor&lt;/b&gt;: &lt;b&gt;imposible&lt;/b&gt;.&lt;br&gt;&lt;br&gt;&lt;b&gt;Costo real:&lt;/b&gt; el camión retiene el escáner mientras maniobra, lo que reduce la concurrencia. Por eso «sin prevención» existe como modo para provocar el deadlock a propósito." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=12;fontColor=#2b3440;align=left;verticalAlign=middle;fontStyle=0;dashed=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="330" y="495" width="520" height="125" as="geometry" /></mxCell></root></mxGraphModel></diagram>
<diagram name="8. Almacén (paginación)" id="redxela-08"><mxGraphModel dx="880" dy="680" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="880" pageHeight="680" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="k1" value="Lotes (≈ procesos)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#dae8fc;fillOpacity=35;strokeColor=#6c8ebf;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=14;spacingRight=14;spacingTop=6;fontSize=16;fontStyle=1;fontColor=#2b3440;" vertex="1" parent="1"><mxGeometry x="15" y="10" width="250" height="330" as="geometry" /></mxCell><mxCell id="b2" value="&lt;b&gt;Lote A&lt;/b&gt; · 2.350 camisetas&lt;br&gt;&lt;font style='font-size:11px'&gt;500 por ubicación → 5 ubicaciones&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;fontColor=#2b3440;align=center;verticalAlign=middle;fontStyle=0;dashed=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="30" y="55" width="220" height="60" as="geometry" /></mxCell><mxCell id="b3" value="&lt;b&gt;Lote B&lt;/b&gt; · 18 refrigeradoras&lt;br&gt;&lt;font style='font-size:11px'&gt;16 por ubicación → 2 ubicaciones&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=12;fontColor=#2b3440;align=center;verticalAlign=middle;fontStyle=0;dashed=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="30" y="128" width="220" height="60" as="geometry" /></mxCell><mxCell id="b4" value="&lt;b&gt;Lote C&lt;/b&gt; · 700 novelas&lt;br&gt;&lt;font style='font-size:11px'&gt;500 por ubicación → 2 ubicaciones&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=12;fontColor=#2b3440;align=center;verticalAlign=middle;fontStyle=0;dashed=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="30" y="201" width="220" height="60" as="geometry" /></mxCell><mxCell id="t5" value="Cada ubicación guarda unidades &lt;b&gt;enteras de un solo producto&lt;/b&gt; y pertenece a un solo lote." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#2b3440;fontStyle=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="30" y="268" width="220" height="66" as="geometry" /></mxCell><mxCell id="k6" value="Tabla de páginas del lote" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fff2cc;fillOpacity=35;strokeColor=#d6b656;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=14;spacingRight=14;spacingTop=6;fontSize=16;fontStyle=1;fontColor=#2b3440;" vertex="1" parent="1"><mxGeometry x="285" y="10" width="250" height="330" as="geometry" /></mxCell><mxCell id="b7" value="&lt;b&gt;A&lt;/b&gt; → ubicaciones 0, 1, 2, 3, 9" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;fontColor=#2b3440;align=center;verticalAlign=middle;fontStyle=0;dashed=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="300" y="55" width="220" height="60" as="geometry" /></mxCell><mxCell id="b8" value="&lt;b&gt;B&lt;/b&gt; → ubicaciones 4, 11" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=12;fontColor=#2b3440;align=center;verticalAlign=middle;fontStyle=0;dashed=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="300" y="128" width="220" height="60" as="geometry" /></mxCell><mxCell id="b9" value="&lt;b&gt;C&lt;/b&gt; → ubicaciones 10, 17" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=12;fontColor=#2b3440;align=center;verticalAlign=middle;fontStyle=0;dashed=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="300" y="201" width="220" height="60" as="geometry" /></mxCell><mxCell id="t10" value="No hace falta que sean contiguas: &lt;b&gt;no existe fragmentación externa&lt;/b&gt;." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#2b3440;fontStyle=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="300" y="268" width="220" height="66" as="geometry" /></mxCell><mxCell id="k11" value="Almacén (un pasillo de ejemplo)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#d5e8d4;fillOpacity=35;strokeColor=#82b366;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=14;spacingRight=14;spacingTop=6;fontSize=16;fontStyle=1;fontColor=#2b3440;" vertex="1" parent="1"><mxGeometry x="555" y="10" width="310" height="330" as="geometry" /></mxCell><mxCell id="c12" value="&lt;font style='font-size:9px;color:#5b6676'&gt;0&lt;/font&gt;&lt;br&gt;A" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=11;fontColor=#2b3440;" vertex="1" parent="1"><mxGeometry x="573" y="58" width="31" height="36" as="geometry" /></mxCell><mxCell id="c13" value="&lt;font style='font-size:9px;color:#5b6676'&gt;1&lt;/font&gt;&lt;br&gt;A" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=11;fontColor=#2b3440;" vertex="1" parent="1"><mxGeometry x="607" y="58" width="31" height="36" as="geometry" /></mxCell><mxCell id="c14" value="&lt;font style='font-size:9px;color:#5b6676'&gt;2&lt;/font&gt;&lt;br&gt;A" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=11;fontColor=#2b3440;" vertex="1" parent="1"><mxGeometry x="641" y="58" width="31" height="36" as="geometry" /></mxCell><mxCell id="c15" value="&lt;font style='font-size:9px;color:#5b6676'&gt;3&lt;/font&gt;&lt;br&gt;A" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=11;fontColor=#2b3440;" verte