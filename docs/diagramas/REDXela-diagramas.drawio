<diagram name="3. Hilos y sincronización" id="redxela-03"><mxGraphModel dx="880" dy="770" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="880" pageHeight="770" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="t1" value="Hilos (morado) y los objetos compartidos que los coordinan (naranja)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=15;fontColor=#2b3440;fontStyle=1;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="20" y="6" width="700" height="26" as="geometry" /></mxCell><mxCell id="i2" value="" style="shape=mxgraph.networks2.users;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="87.0" y="50" width="46.0" height="46" as="geometry" /></mxCell><mxCell id="t3" value="&lt;b&gt;Generador&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px;color:#5b6676'&gt;hilo · Condition de config.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=14;fontColor=#2b3440;fontStyle=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="25.0" y="98" width="170" height="44" as="geometry" /></mxCell><mxCell id="i4" value="" style="shape=mxgraph.lean_mapping.fifo_lane;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="418.0" y="52" width="44.0" height="44" as="geometry" /></mxCell><mxCell id="t5" value="&lt;b&gt;WaitingList&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px;color:#5b6676'&gt;Lock + Condition changed&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=14;fontColor=#2b3440;fontStyle=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="345.0" y="98" width="190" height="44" as="geometry" /></mxCell><mxCell id="i6" value