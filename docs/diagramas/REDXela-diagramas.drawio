0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b10" target="b13"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="k16" value="Lo que NO es presentación (los componentes de presentación no hacen fetch ni abren sockets)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fillOpacity=35;strokeColor=#666666;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=14;spacingRight=14;spacingTop=6;fontSize=16;fontStyle=1;fontColor=#2b3440;" vertex="1" parent="1"><mxGeometry x="15" y="240" width="850" height="305" as="geometry" /></mxCell><mxCell id="i17" value="" style="shape=mxgraph.networks2.server;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="88.0" y="285" width="44.0" height="44" as="geometry" /></mxCell><mxCell id="t18" value="&lt;b&gt;hooks/&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px;color:#5b6676'&gt;useSimulationStream · useRemoteAction&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=14;fontColor=#2b3440;fontStyle=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="10.0" y="331" width="200" height="60" as="geometry" /></mxCell><mxCell id="i19" value="" style="shape=mxgraph.lean_mapping.mrp_erp;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="308.0" y="285" width="44.0" height="44" as="geometry" /></mxCell><mxCell id="t20" value="&lt;b&gt;services/&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px;color:#5b6676'&gt;apiClient · *Api.ts (REST)&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=14;fontColor=#2b3440;fontStyle=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="245.0" y="331" width="170" height="50" as="geometry" /></mxCell><mxCell id="i21" value="" style="shape=mxgraph.lean_mapping.control_center;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="528.0" y="285" width="44.0" height="44" as="geometry" /></mxCell><mxCell id="t22" value="&lt;b&gt;utils/&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px;color:#5b6676'&gt;funciones puras con tests&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=14;fontColor=#2b3440;fontStyle=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="465.0" y="331" width="170" height="50" as="geometry" /></mxCell><mxCell id="i23" value="" style="shape=mxgraph.lean_mapping.orders;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="738.0" y="285" width="44.0" height="44" as="geometry" /></mxCell><mxCell id="t24" value="&lt;b&gt;types/ · constants/&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px;color:#5b6676'&gt;contrato JSON y valores fijos&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=14;fontColor=#2b3440;fontStyle=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="675.0" y="331" width="170" height="50" as="geometry" /></mxCell><mxCell id="e25" value="llama" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#4a5568;endArrow=block;endFill=1;fontSize=12;fontColor=#2b3440;labelBackgroundColor=#ffffff;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="i17" target="i19"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="b26" value="&lt;b&gt;Flujo de datos:&lt;/b&gt; el hook abre el WebSocket y recibe un &lt;i&gt;snapshot&lt;/i&gt; completo cada 300 ms → &lt;b&gt;DashboardPage&lt;/b&gt; lo reparte por props a organismos y moléculas; las acciones del usuario (crear pedido, cambiar política, reiniciar…) suben como callbacks hasta la página, que las ejecuta con &lt;code&gt;useRemoteAction&lt;/code&gt; sobre los servicios.&lt;br&gt;&lt;br&gt;&lt;b&gt;Estilos:&lt;/b&gt; CSS Modules y solo los tokens de &lt;code&gt;styles/tokens.css&lt;/code&gt; (colores, espaciados, modo oscuro).&lt;br&gt;&lt;b&gt;Pruebas:&lt;/b&gt; cada componente vive en su carpeta con &lt;code&gt;index.ts&lt;/code&gt;, estilos y test (Vitest + Testing Library)." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=12;fontColor=#2b3440;align=left;verticalAlign=middle;fontStyle=0;dashed=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="415" width="800" height="115" as="geometry" /></mxCell></root></mxGraphModel></diagram>
</mxfile>