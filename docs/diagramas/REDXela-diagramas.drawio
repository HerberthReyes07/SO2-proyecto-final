vertex="1" parent="1"><mxGeometry x="660.0" y="107" width="150" height="44" as="geometry" /></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#4a5568;endArrow=block;endFill=1;fontSize=12;fontColor=#2b3440;labelBackgroundColor=#ffffff;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="i2" target="i4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#4a5568;endArrow=block;endFill=1;fontSize=12;fontColor=#2b3440;labelBackgroundColor=#ffffff;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="i4" target="i6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#4a5568;endArrow=block;endFill=1;fontSize=12;fontColor=#2b3440;labelBackgroundColor=#ffffff;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="i6" target="i8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e15" value="elige el mejor" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#4a5568;endArrow=block;endFill=1;fontSize=12;fontColor=#2b3440;labelBackgroundColor=#ffffff;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="i8" target="i10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="b16" value="&lt;b&gt;Decisión tardía.&lt;/b&gt; El despachador espera a que haya un pedido &lt;i&gt;elegible&lt;/i&gt; (con stock completo) y un encargado libre, y &lt;b&gt;solo entonces&lt;/b&gt; elige con la política vigente (FIFO, prioridad, envejecimiento, EDF o SJF). Si un Exprés llega mientras no hay encargado, no queda detrás de uno elegido de antemano.&lt;br&gt;Si falta stock, el pedido espera &lt;b&gt;sin retener nada&lt;/b&gt;; al llegar mercadería (&lt;font face='Courier New'&gt;stockChanged&lt;/font&gt;) se reevalúa la lista." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=13;fontColor=#2b3440;align=left;verticalAlign=middle;fontStyle=0;dashed=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="175" width="770" height="105" as="geometry" /></mxCell><mxCell id="k17" value="2 · Procesamiento: un hilo por pedido (máximo 10 a la vez, uno por encargado)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#d5e8d4;fillOpacity=35;strokeColor=#82b366;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=14;spacingRight=14;spacingTop=6;fontSize=16;fontStyle=1;fontColor=#2b3440;" vertex="1" parent="1"><mxGeometry x="20" y="330" width="840" height="270" as="geometry" /></mxCell><mxCell id="i18" value="" style="shape=mxgraph.lean_mapping.move_by_forklift;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="100.0" y="372" width="50.0" height="50" as="geometry" /></mxCell><mxCell id="t19" value="&lt;b&gt;Picking&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px;color:#5b6676'&gt;Encargado + montacargas*&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=14;fontColor=#2b3440;fontStyle=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="42.5" y="424" width="165" height="44" as="geometry" /></mxCell><mxCell id="i20" value="" style="shape=mxgraph.gcp2.search;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="260.0" y="372" width="50.0" height="50" as="geometry" /></mxCell><mxCell id="t21" value="&lt;b&gt;Inspección&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px;color:#5b6676'&gt;Control de calidad*&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=14;fontColor=#2b3440;fontStyle=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="202.5" y="424" width="165" height="44" as="geometry" /></mxCell><mxCell id="i22" value="" style="shape=mxgraph.lean_mapping.work_cell;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="420.0" y="372" width="50.0" height="50" as="geometry" /></mxCell><mxCell id="t23" value="&lt;b&gt;Empaque&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px;color:#5b6676'&gt;Estación de empaque*&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=14;fontColor=#2b3440;fontStyle=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="362.5" y="424" width="165" height="44" as="geometry" /></mxCell><mxCell id="i24" value="" style="shape=mxgraph.networks2.scanner;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="562.0" y="372" width="50.0" height="50" as="geometry" /></mxCell><mxCell id="t25" value="&lt;b&gt;Despacho&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px;color:#5b6676'&gt;Escáner → Área de carga&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=14;fontColor=#2b3440;fontStyle=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="502.0" y="424" width="170" height="44" as="geometry" /></mxCell><mxCell id="i26" value="" style="shape=mxgraph.lean_mapping.truck_shipment;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="624.0" y="372" width="46.0" height="46" as="geometry" /></mxCell><mxCell id="i27" value="" style="shape=mxgraph.sitemap.chart;html=1;fillColor=#d0ece9;strokeColor=#2a9d8f;strokeWidth=2;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="765.0" y="372" width="50.0" height="50" as="geometry" /></mxCell><mxCell id="t28" value="&lt;b&gt;Despachado&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px;color:#5b6676'&gt;estadísticas y stock&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=14;fontColor=#2b3440;fontStyle=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="725.0" y="424" width="130" height="44" as="geometry" /></mxCell><mxCell id="e29" value="asigna encargado" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#9673a6;endArrow=block;endFill=1;fontSize=12;fontColor=#2b3440;labelBackgroundColor=#ffffff;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="i10" target="i18"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="835" y="80" /><mxPoint x="835" y="315" /><mxPoint x="27" y="315" /><mxPoint x="27" y="397" /></Array></mxGeometry></mxCell><mxCell id="e30" value="traspaso" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#4a5568;endArrow=block;endFill=1;fontSize=12;fontColor=#2b3440;labelBackgroundColor=#ffffff;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="i18" target="i20"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e31" value="traspaso" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#4a5568;endArrow=block;endFill=1;fontSize=12;fontColor=#2b3440;labelBackgroundColor=#ffffff;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="i20" target="i22"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e32" value="traspaso" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#4a5568;endArrow=block;endFill=1;fontSize=12;fontColor=#2b3440;labelBackgroundColor=#ffffff;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="i22" target="i24"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#4a5568;endArrow=block;endFill=1;fontSize=12;fontColor=#2b3440;labelBackgroundColor=#ffffff;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="i26" target="i27"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="b34" value="&lt;b&gt;Traspaso entre etapas.&lt;/b&gt; Se adquieren primero los recursos de la etapa siguiente y &lt;b&gt;solo después&lt;/b&gt; se sueltan los de la anterior: la mercancía nunca queda &amp;laquo;en el aire&amp;raquo; (el montacargas no se libera hasta que Empaque aceptó el pedido).&lt;br&gt;Pase lo que pase (interrupción, expulsión por deadlock, error), un &lt;font face='Courier New'&gt;finally&lt;/font&gt; libera todo lo retenido.&lt;br&gt;* Cada tipo de mercancía usa solo los recursos de su receta (ver sección 3.3 del manual)." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=13;fontColor=#2b3440;align=left;verticalAlign=middle;fontStyle=0;dashed=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="485" width="800" height="100" as="geometry" /></mxCell><mxCell id="k35" value="Orden global de recursos (rank): siempre se piden en este orden → no hay espera circular entre pedidos" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fillOpacity=35;strokeColor=#666666;strokeWidth=2;dashed=0;verticalAlign=top;align=left;spacingLeft=14;spacingRight=14;spacingTop=6;fontSize=16;fontStyle=1;fontColor=#2b3440;" vertex="1" parent="1"><mxGeometry x="20" y="625" width="840" height="85" as="geometry" /></mxCell><mxCell id="b36" value="1 Encargado" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=13;fontColor=#2b3440;align=center;verticalAlign=middle;fontStyle=1;dashed=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="660" width="108" height="38" as="geometry" /></mxCell><mxCell id="b37" value="2 Montacargas" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=13;fontColor=#2b3440;align=center;verticalAlign=middle;fontStyle=1;dashed=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="162" y="660" width="124" height="38" as="geometry" /></mxCell><mxCell id="e38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#4a5568;endArrow=block;endFill=1;fontSize=12;fontColor=#2b3440;labelBackgroundColor=#ffffff;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b36" target="b37"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="b39" value="3 Control de calidad" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=13;fontColor=#2b3440;align=center;verticalAlign=middle;fontStyle=1;dashed=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="300" y="660" width="152" height="38" as="geometry" /></mxCell><mxCell id="e40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#4a5568;endArrow=block;endFill=1;fontSize=12;fontColor=#2b3440;labelBackgroundColor=#ffffff;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b37" target="b39"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="b41" value="4 Empaque" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=13;fontColor=#2b3440;align=center;verticalAlign=middle;fontStyle=1;dashed=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="466" y="660" width="96" height="38" as="geometry" /></mxCell><mxCell id="e42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#4a5568;endArrow=block;endFill=1;fontSize=12;fontColor=#2b3440;labelBackgroundColor=#ffffff;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b39" target="b41"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="b43" value="5 Escáner" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=13;fontColor=#2b3440;align=center;verticalAlign=middle;fontStyle=1;dashed=0;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="576" y="660" width="100" height="38" as="geometry" /></mxCell><mxCell id="e44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#4a5568;endArrow=block;endFill=1;fontSize=12;fontColor=#2b3440;labelBackgroundColor=#ffffff;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b41" target="b43"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="b45" value="6 Área de carga" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=13;fontColor=#2b3440;align=center;verticalAlign=middle;fontStyl